# ---------------------------------------------------------------------------
# TAG CHANGED 2026-08-26: --vbs-deta=0 is now the DEFAULT, so it no longer
# contributes a "deta0p0" component. The output tag is now "mjj500p0" alone.
# Filenames below were updated to match; the old paths in any notes or
# scripts that reference this run will not resolve.
# ---------------------------------------------------------------------------
# ---------------------------------------------------------------------------
# rpt_v5_hist_deta0_mjj500.sub — rpt_v5_hist on a tightened, analysis-level
# VBS event selection: |Deta| requirement OFF, m_jj >= 500 GeV.
#
# Identical to rpt_v5_hist.sub except for `--vbs-deta=0 --vbs-mjj=500`.
#
# Why these values: vbs_mjj_diag (util/vbs_mjj_diag.cxx) measured both topology
# variables against the candidate pair's truth-HS-match denominator on all
# three samples. The default |Deta| >= 3 cut is purity-NEGATIVE on Z+jets
# (2.69% -> 2.51%) and dijet (40.1% -> 35.0%) -- it preferentially admits
# pileup-legged pairs -- so it is disabled here rather than stacked with m_jj.
# m_jj >= 500 sits on the rising edge of the purity curve (VBF 61.0% at 81.6%
# kept, dijet 43.4% at 75.2% kept), tighter than the 200 GeV working point used
# for the clustering_hist run.
#
# SCOPE: these knobs gate the two VBS-topology REGIONS ONLY (R1: both candidate
# legs forward; R2: forward PU leg + central HS leg). They do NOT affect the
# inclusive _lo/_hi histograms, which rpt_v5 keeps selection-free by design.
# (An earlier version of this header claimed otherwise, and before the fix in
# rpt_v5_hist.cxx the knobs were inert entirely -- calcBestVbsPair only finds
# the pair, it does not cut on it -- so two different --vbs-mjj runs produced
# identical physics under different filenames.) On Z+jets in
# particular, expect R1 to be statistics-starved -- vbs_mjj_diag found only
# 1,872 genuine (both-legs-truth-HS) pairs in 2M events even with NO topology
# cut -- so check the region yields rpt_v5_plot prints before reading its ROC.
#
# Output names are tagged by resolveSelection(), so these land as
# <sample>/<sample>_mjj500p0_rpt_v5_hist.root and CANNOT overwrite the
# standard rpt_v5_hist run. rpt_v5_plot needs the matching
# --vbs-deta=0 --vbs-mjj=500 (or an explicit --hist-file=) to find them.
#
# Setup (once):
#   cd build && cmake .. && make rpt_v5_hist        # build BEFORE submitting
#   chmod +x condor/run_analysis.sh
#
# Submit (from inside condor/, so relative paths below resolve correctly):
#   cd condor && condor_submit rpt_v5_hist_deta0_mjj500.sub
# ---------------------------------------------------------------------------
universe                 = vanilla
executable               = run_analysis.sh
arguments                = rpt_v5_hist $(sample) 4 --vbs-deta=0 --vbs-mjj=500

should_transfer_files    = YES
when_to_transfer_output  = ON_EXIT
transfer_input_files     = ../build/rpt_v5_hist
transfer_output_files    = $(sample)/$(sample)_mjj500p0_rpt_v5_hist.root

# Same remap rationale as rpt_v5_hist.sub: condor flattens a nested
# transfer_output_files path to its basename when staging back, so the remap is
# what makes the file land under $(sample)/ on the submit side. The LHS must be
# a BARE FILENAME -- per condor_submit(1), "You cannot specify directories to be
# remapped" -- while directories are allowed on the RHS and created as needed.
transfer_output_remaps   = "$(sample)_mjj500p0_rpt_v5_hist.root=$(sample)/$(sample)_mjj500p0_rpt_v5_hist.root"

getenv                   = True

+JobFlavour              = "tomorrow"

# rpt_v5_hist parallelizes its event loop via TTreeProcessorMT. The `4` in
# `arguments` above is forwarded as --threads=4 by run_analysis.sh --
# request_cpus must track that value, since condor's cgroup throttles any
# threads spawned beyond what was requested, silently eating the speedup.
request_cpus             = 4
request_memory           = 4GB
request_disk             = 4GB

output                   = logs/rpt_v5_deta0_mjj500_$(sample).$(ClusterId).$(ProcId).out
error                    = logs/rpt_v5_deta0_mjj500_$(sample).$(ClusterId).$(ProcId).err
log                      = logs/rpt_v5_deta0_mjj500_$(sample).$(ClusterId).$(ProcId).log

queue sample in (vbf, zjets, dijet)
