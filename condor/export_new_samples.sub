# ---------------------------------------------------------------------------
# export_new_samples.sub — training-data export for the mu=0 samples and the
# channel-matched mu=200 control.
#
# Queues four jobs:
#   vbf_mu0      600026 r15697  pairs with vbf      -> the INTRINSIC TIMING FLOOR
#   zeejets_mu0  601189 r15697  pairs with zeejets  -> forward-jet-is-pileup test
#   zeejets      601189 r15700  the mu=200 control  -> without it the mu0 Zee
#                                                      numbers have nothing
#                                                      like-for-like to sit beside
#   ttbar_mu0    601229 r15697  no mu=200 pair yet (ttbar still downloading)
#
# Standard (tight) selection deliberately: these have to be comparable to the
# existing baselines. A loose (--vbs-deta=-1) pass is a separate submit once the
# tight numbers are in -- it would tell us whether any mu0 shortfall is the VBS
# pair requirement or the forward-jet requirement, and that is a different
# question from the one this answers.
#
# EXPECT zeejets_mu0 and ttbar_mu0 TO PASS ALMOST NOTHING. passJetPtCut needs a
# forward jet (2.38 < |eta| < 4.0, pT > 30 GeV) and neither process makes one on
# its own, so at mu=200 that requirement is largely satisfied by PILEUP jets.
# The "events passing" line is then the measurement, not a failure -- it
# quantifies how much of our forward-jet population is pileup.
#
#   cd build && cmake .. && make export_training_data   # build BEFORE submitting
#   cd ../condor && condor_submit export_new_samples.sub
# ---------------------------------------------------------------------------
universe                 = vanilla
executable               = run_analysis.sh

arguments                = export_training_data $(sample)

should_transfer_files    = YES
when_to_transfer_output  = ON_EXIT
transfer_input_files     = ../build/export_training_data
transfer_output_files    = $(sample)/$(sample)_training.root
# LHS must be a BARE FILENAME -- condor_submit(1): "You cannot specify
# directories to be remapped". Directories are allowed on the RHS.
transfer_output_remaps   = "$(sample)_training.root=$(sample)/$(sample)_training.root"

getenv                   = True
+JobFlavour              = "tomorrow"

# Sequential TTreeReader loop, so one core. ttbar_mu0 is the big one (81 GB, 987
# files); the mu=0 samples have no pileup so their per-event track multiplicity
# is far lower than mu=200, which keeps the output small even when many events
# pass.
request_cpus             = 1
request_memory           = 6GB
request_disk             = 24GB

output = logs/export_$(sample).$(ClusterId).$(ProcId).out
error  = logs/export_$(sample).$(ClusterId).$(ProcId).err
log    = logs/export_$(sample).$(ClusterId).$(ProcId).log

queue sample in (vbf_mu0, zeejets_mu0, zeejets, ttbar_mu0)
