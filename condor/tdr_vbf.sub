# tdr_vbf (TDR Sec. 3.4.1 event tree), one sample sharded $(nshards) ways.
# The TDR programs clean track times by default, which needs Track_hitInLastLayer:
# the skims drop it, so pass the RAW ntuples through inputargs, e.g.
#   condor_submit -a sample=zjets -a nshards=20 \
#     -a 'inputargs=--ntuple-dir=/data/mcardiff/exotic_superntuples/zjets/' \
#     -a 'requirements = (TARGET.Machine =!= "c113.af.uchicago.edu") && (TARGET.Machine =!= "c114.af.uchicago.edu")' \
#     tdr_vbf.sub
# The tree is TTree-only: merge the shards with hadd -f (not hist_merge), globbing on the shard count.
# A non-default mode tags the file (--clean-times=t0|off: cleant0_/rawtimes_, --rpt-match=dr02: dr02_,
# --gate-sigma: gateXpY_): pass it in selargs AND the matching tag in seltag.
universe                 = vanilla
executable               = run_analysis.sh
sample                   = zjets
nshards                  = 20
selargs                  =
seltag                   =
inputargs                =
arguments                = tdr_vbf $(sample) --file-shard=$(ProcId)/$(nshards) $(selargs) $(inputargs)
should_transfer_files    = YES
when_to_transfer_output  = ON_EXIT
transfer_input_files     = ../build/tdr_vbf
transfer_output_files    = $(sample)/$(sample)_$(seltag)tdr_vbf.shard$(ProcId)of$(nshards).root
transfer_output_remaps   = "$(sample)_$(seltag)tdr_vbf.shard$(ProcId)of$(nshards).root=$(sample)/$(sample)_$(seltag)tdr_vbf.shard$(ProcId)of$(nshards).root"
getenv                   = True
stream_output            = True
stream_error             = True
+JobFlavour              = "workday"
request_cpus             = 1
request_memory           = 4GB
request_disk             = 2GB
output                   = logs/tdr_vbf_$(sample).$(ClusterId).$(ProcId).out
error                    = logs/tdr_vbf_$(sample).$(ClusterId).$(ProcId).err
log                      = logs/tdr_vbf_$(sample).$(ClusterId).$(ProcId).log
queue $(nshards)
