# The TDR-structured programs (prog = tdr_vbf | tdr_pujet | tdr_t0 | tdr_fwdpair), one sample sharded $(nshards) ways.
# The TDR programs clean track times by default, which needs Track_hitInLastLayer:
# the skims drop it, so pass the RAW ntuples through inputargs, e.g.
#   condor_submit -a prog=tdr_vbf -a sample=zjets -a nshards=20 \
#     -a 'inputargs=--ntuple-dir=/data/mcardiff/exotic_superntuples/zjets/' \
#     -a 'requirements = (TARGET.Machine =!= "c113.af.uchicago.edu") && (TARGET.Machine =!= "c114.af.uchicago.edu")' \
#     tdr.sub
# The VBF raw directory is highstats_vbf (not vbf).
# Every output is TTree-only: merge the shards with hadd -f (not hist_merge), globbing on the shard
# count. tdr_t0 skips its fit when sharded: run tdr_t0 --fit=<merged file> after the merge.
# A non-default mode tags the file (--clean-times=t0|off: cleant0_/rawtimes_, --rpt-match=dr02: dr02_,
# --gate-sigma: gateXpY_): pass it in selargs AND the matching tag in seltag.
universe                 = vanilla
executable               = run_analysis.sh
prog                     = tdr_vbf
sample                   = zjets
nshards                  = 20
selargs                  =
seltag                   =
inputargs                =
arguments                = $(prog) $(sample) --file-shard=$(ProcId)/$(nshards) $(selargs) $(inputargs)
should_transfer_files    = YES
when_to_transfer_output  = ON_EXIT
transfer_input_files     = ../build/$(prog)
transfer_output_files    = $(sample)/$(sample)_$(seltag)$(prog).shard$(ProcId)of$(nshards).root
transfer_output_remaps   = "$(sample)_$(seltag)$(prog).shard$(ProcId)of$(nshards).root=$(sample)/$(sample)_$(seltag)$(prog).shard$(ProcId)of$(nshards).root"
getenv                   = True
stream_output            = True
stream_error             = True
+JobFlavour              = "workday"
request_cpus             = 1
request_memory           = 4GB
request_disk             = 2GB
output                   = logs/$(prog)_$(sample).$(ClusterId).$(ProcId).out
error                    = logs/$(prog)_$(sample).$(ClusterId).$(ProcId).err
log                      = logs/$(prog)_$(sample).$(ClusterId).$(ProcId).log
queue $(nshards)
