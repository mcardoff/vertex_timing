# ---------------------------------------------------------------------------
# rpt_v5_hist_deta0_mjj200.sub — rpt_v5_hist at the LOOSER m_jj working point:
# |Deta| requirement OFF, m_jj >= 200 GeV. All three samples.
#
# Identical to rpt_v5_hist_deta0_mjj500.sub except for `--vbs-mjj=200`.
#
# Why: the m_jj >= 500 run left Z+jets' R1 region (both VBS candidate legs
# forward, one truth-HS + one truth-PU) with only 749 forward legs. At that
# yield every R1 ROC curve ran out of points around HS efficiency ~0.92, so the
# 0.95/0.97 columns of the rejection table just repeated the last computed
# value rather than measuring anything, and two ratio graphs came out empty
# ("illegal number of points (0)" from TGraphPainter). Loosening to 200 GeV
# trades topology purity for the statistics R1 needs to produce a readable
# curve at all.
#
# Expect this to be a genuinely different -- looser -- event selection, not a
# higher-statistics version of the same one. vbs_mjj_diag measured Z+jets
# candidate-pair purity (both legs truth-HS) at 2.69% with no topology cut and
# 2.68% at m_jj >= 200, i.e. essentially the no-cut population: Z+jets simply
# has very little genuine forward VBS topology (1,872 genuine pairs in 2M
# events). Do NOT compare its ROCs directly against the m_jj >= 500 vbf/dijet
# runs.
#
# Output tag is deta0p0_mjj200p0, so this cannot overwrite either the standard
# run or the m_jj >= 500 one. rpt_v5_plot needs the matching
# --vbs-deta=0 --vbs-mjj=200 (or an explicit --hist-file=) to find it.
#
# Submit (from inside condor/):
#   cd build && cmake .. && make rpt_v5_hist        # build BEFORE submitting
#   cd ../condor && condor_submit rpt_v5_hist_deta0_mjj200.sub
# ---------------------------------------------------------------------------
universe                 = vanilla
executable               = run_analysis.sh
arguments                = rpt_v5_hist $(sample) 4 --vbs-deta=0 --vbs-mjj=200

should_transfer_files    = YES
when_to_transfer_output  = ON_EXIT
transfer_input_files     = ../build/rpt_v5_hist
transfer_output_files    = $(sample)/$(sample)_deta0p0_mjj200p0_rpt_v5_hist.root

# Same remap rationale as the other .sub files: condor flattens a nested
# transfer_output_files path to its basename when staging back, so the remap is
# what makes the file land under $(sample)/ on the submit side. The LHS must be
# a BARE FILENAME -- per condor_submit(1), "You cannot specify directories to be
# remapped" -- while directories are allowed on the RHS and created as needed.
transfer_output_remaps   = "$(sample)_deta0p0_mjj200p0_rpt_v5_hist.root=$(sample)/$(sample)_deta0p0_mjj200p0_rpt_v5_hist.root"

getenv                   = True

+JobFlavour              = "tomorrow"

# rpt_v5_hist parallelizes its event loop via TTreeProcessorMT; request_cpus
# must track the `4` forwarded as --threads=4 in `arguments` above, since
# condor's cgroup throttles anything spawned beyond what was requested.
request_cpus             = 4
request_memory           = 4GB
request_disk             = 4GB

output                   = logs/rpt_v5_deta0_mjj200_$(sample).$(ClusterId).$(ProcId).out
error                    = logs/rpt_v5_deta0_mjj200_$(sample).$(ClusterId).$(ProcId).err
log                      = logs/rpt_v5_deta0_mjj200_$(sample).$(ClusterId).$(ProcId).log

queue sample in (vbf, zjets, dijet)
