# ---------------------------------------------------------------------------
# clustering_hist.sub — condor submit template: one SAMPLE per submit,
# split into $(nshards) parallel shard jobs.
#
# Histogramming stage of the clustering_dt split (see CLAUDE.md's "Main
# Executables" section): runs the event loop and writes
# <sample>/<sample>_clustering_hist.root, nothing else. Transfers back a
# single small ROOT file instead of a full figs/ directory of PDFs -- run
# `./clustering_plot --sample=<sample>` locally afterward to produce the PDFs
# from that file, which is fast/local and needs no further condor submission.
#
# Setup (once):
#   cd build && cmake .. && make clustering_hist    # build BEFORE submitting
#   chmod +x condor/run_analysis.sh
#
# Submit (from inside condor/, so relative paths below resolve correctly).
# One condor_submit per sample -- each gets its own ClusterId, and shard
# counts differ per sample because event counts do:
#   cd condor
#   condor_submit -a sample=vbf   -a nshards=4  clustering_hist.sub
#   condor_submit -a sample=dijet -a nshards=4  clustering_hist.sub
#   condor_submit -a sample=zjets -a nshards=32 clustering_hist.sub
#
# Then merge each sample's shards (hist_merge, NOT hadd -- see below):
#   cd ../build
#   ./hist_merge ../zjets/zjets_clustering_hist.root ../zjets/zjets_clustering_hist.shard*of32.root
#
# Execute hosts don't share a filesystem with the submit host (confirmed via
# a FileSystemDomain match failure), so the built executable is staged in via
# transfer_input_files and the histogram file is staged back via
# transfer_output_files. The ntuple inputs themselves are read from
# /data/mcardiff/... (an absolute path baked into --sample=vbf|zjets|dijet),
# not transferred.
#
# Sharding exists because a single unsplit job pays the whole per-file
# startup serially (0.3-1.2 s per file on /data) AND runs the whole event
# loop -- together, 183 minutes for zjets. Splitting divides both. Validated
# bit-identical against an unsplit run before first use; see CLAUDE.md.
#
# This queues $(nshards) jobs for ONE sample.
# ---------------------------------------------------------------------------
universe                 = vanilla
executable               = run_analysis.sh
# One sample per submit, sharded $(nshards) ways. Both are macros with
# defaults, overridden per submission:
#   condor_submit -a sample=zjets -a nshards=32 clustering_hist.sub
#
# Shard counts should track EVENT count, not file count: zjets has 8.08M
# events against vbf's 0.50M and dijet's 0.70M (measured, see CLAUDE.md's
# "Job cost" section), so an equal split across samples would leave zjets
# jobs ~16x longer than the rest. Suggested: vbf 4, dijet 4, zjets 32.
sample                   = vbf
nshards                  = 4

# Non-default VBS selection (resolveSelection in src/sample_config.h).
# Empty = the standard selection, and every path below is then exactly as
# documented above.
#
# These two MUST agree: selargs changes the cuts, and the executable stamps a
# matching SELECTION_TAG onto the output FILENAME so a loosened run cannot
# overwrite the standard one. transfer_output_files has to name that same
# file. seltag is that tag INCLUDING its trailing underscore.
#
#   selargs                          seltag
#   (empty)                          (empty)
#   --vbs-deta=0                     deta0p0_
#   --vbs-mjj=200                    mjj200p0_
#   --vbs-deta=0 --vbs-mjj=200       deta0p0_mjj200p0_
#
# Verify before submitting -- `condor_submit -dump` prints the expanded
# transfer_output_files, and running the executable locally with the same
# selargs prints "[selection] ... (tag: ...)". A mismatch is not silent: the
# job completes and then goes on hold failing to transfer a file that does
# not exist.
selargs                  =
seltag                   =

arguments                = clustering_hist $(sample) 4 --file-shard=$(ProcId)/$(nshards) $(selargs)

should_transfer_files    = YES
when_to_transfer_output  = ON_EXIT
transfer_input_files     = ../build/clustering_hist
transfer_output_files    = $(sample)/$(sample)_$(seltag)clustering_hist.shard$(ProcId)of$(nshards).root
# The histogram file name is now sample-prefixed (src/sample_config.h's
# histFilePath()), so the 3 queued jobs' output basenames
# (vbf_clustering_hist.root, zjets_clustering_hist.root,
# dijet_clustering_hist.root) no longer collide even after condor's default
# output-transfer flattening -- unlike when the file was just
# "clustering_hist.root" for every sample (see git history for that bug). A
# remap is still used below, purely so the file lands nested under
# $(sample)/ on the submit side, matching the local --sample= convention
# (clustering_plot --sample=<sample> looks for it there without needing
# --hist-file=).
#
# preserve_relative_paths = True also fixes the old collision, but it's a
# submit-wide knob that applies to transfer_input_files too -- and turned
# "../build/clustering_hist" (climbs OUT of the sandbox) from
# silently-flattened into a hard "Attempt to write to illegal sandbox path"
# hold (confirmed by running the actual rpt_v5_hist jobs with that flag
# set). transfer_output_remaps only touches the output side, so it can't
# have that side effect.
#
# The remap's LHS (`name`) must be a bare filename -- per condor_submit(1):
# "You cannot specify directories to be remapped." A first attempt using a
# full nested path on the LHS silently failed to match anything (confirmed
# against the real rpt_v5_hist jobs: still flattened to a single shared
# file), since condor tracks the transferred file by its basename once
# inside the execution directory, not by the path used to locate it via
# transfer_output_files. Directories ARE allowed on the RHS (`newname`) and
# are created as needed.
transfer_output_remaps   = "$(sample)_$(seltag)clustering_hist.shard$(ProcId)of$(nshards).root=$(sample)/$(sample)_$(seltag)clustering_hist.shard$(ProcId)of$(nshards).root"
# $(ProcId) is the shard index: `queue $(nshards)` below runs ProcId
# 0..nshards-1, which --file-shard consumes directly. Merge the results
# afterwards with hist_merge -- NOT hadd, which would silently keep one
# shard's event counts (see util/hist_merge.cxx).

getenv                   = True

# Write .out/.err back to the submit node AS THEY ARE PRODUCED, rather than
# only on exit (condor's default). Without this a `condor_tail` mid-job shows
# whatever happened to be flushed, which for a job whose startup is minutes of
# silent file I/O is indistinguishable from a hang -- and that misread is what
# sent a performance investigation after "file loading" when the executables
# simply were not reporting. Cheap now that the event loop emits one progress
# line per 100k events instead of overwriting a single line every 5k.
stream_output            = True
stream_error             = True

# CERN-style job-length hint; harmless no-op on pools that don't read it,
# remove if your condor pool doesn't recognize +JobFlavour.
+JobFlavour              = "tomorrow"

# clustering_hist parallelizes its event loop via TTreeProcessorMT
# (util/ttreemt_prototype.cxx validated ~3x speedup at 4 threads). The `4`
# in `arguments` above is forwarded as --threads=4 by run_analysis.sh --
# request_cpus must track that value, since condor's cgroup throttles any
# threads spawned beyond what was requested, silently eating the speedup.
request_cpus             = 4
request_memory           = 4GB
request_disk             = 4GB

output                   = logs/clustering_hist_$(sample).$(ClusterId).$(ProcId).out
error                    = logs/clustering_hist_$(sample).$(ClusterId).$(ProcId).err
log                      = logs/clustering_hist_$(sample).$(ClusterId).$(ProcId).log

queue $(nshards)

# After all shards land:
#   cd ../build
#   ./hist_merge ../$(sample)/$(sample)_clustering_hist.root \
#                ../$(sample)/$(sample)_clustering_hist.shard*of$(nshards).root
