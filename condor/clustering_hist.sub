# ---------------------------------------------------------------------------
# clustering_hist.sub — condor submit template: one job per sample.
#
# Histogramming stage of the clustering_dt split (see CLAUDE.md's "Main
# Executables" section): runs the event loop and writes
# <sample>/hists/clustering_hist.root, nothing else. Transfers back a single
# small ROOT file instead of a full figs/ directory of PDFs -- run
# `./clustering_plot --sample=<sample>` locally afterward to produce the PDFs
# from that file, which is fast/local and needs no further condor submission.
#
# Setup (once):
#   cd build && cmake .. && make clustering_hist    # build BEFORE submitting
#   chmod +x condor/run_analysis.sh
#
# Submit (from inside condor/, so relative paths below resolve correctly):
#   cd condor && condor_submit clustering_hist.sub
#
# Execute hosts don't share a filesystem with the submit host (confirmed via
# a FileSystemDomain match failure), so the built executable is staged in via
# transfer_input_files and the histogram file is staged back via
# transfer_output_files. The ntuple inputs themselves are read from
# /data/mcardiff/... (an absolute path baked into --sample=vbf|zjets|dijet),
# not transferred.
#
# This queues 3 jobs, one per --sample value.
# ---------------------------------------------------------------------------
universe                 = vanilla
executable               = run_analysis.sh
arguments                = clustering_hist $(sample) 4

should_transfer_files    = YES
when_to_transfer_output  = ON_EXIT
transfer_input_files     = ../build/clustering_hist
transfer_output_files    = $(sample)/hists/clustering_hist.root
# Without this, condor's default output-transfer behavior flattens nested
# paths to their basename when staging back -- it does NOT recreate
# $(sample)/hists/ on the submit side, so all 3 queued jobs would each write
# back a file literally named "clustering_hist.root" directly into this
# directory, silently overwriting each other (discovered by running the
# actual jobs: only the last-to-finish sample's histogram survived).
preserve_relative_paths  = True

getenv                   = True

# CERN-style job-length hint; harmless no-op on pools that don't read it,
# remove if your condor pool doesn't recognize +JobFlavour.
+JobFlavour              = "tomorrow"

# clustering_hist parallelizes its event loop via TTreeProcessorMT
# (util/ttreemt_prototype.cxx validated ~3x speedup at 4 threads). The `4`
# in `arguments` above is forwarded as --threads=4 by run_analysis.sh --
# request_cpus must track that value, since condor's cgroup throttles any
# threads spawned beyond what was requested, silently eating the speedup.
request_cpus             = 4
request_memory           = 4GB
request_disk             = 4GB

output                   = logs/clustering_hist_$(sample).$(ClusterId).$(ProcId).out
error                    = logs/clustering_hist_$(sample).$(ClusterId).$(ProcId).err
log                      = logs/clustering_hist_$(sample).$(ClusterId).$(ProcId).log

queue sample in (vbf, zjets, dijet)
