# ---------------------------------------------------------------------------
# train_transformer.sub — NO-CLUSTERING vertex-time regression as a condor job.
#
# Torch comes from an LCG view on cvmfs (see run_training.sh) -- python 3.13.11,
# torch 2.11.0, uproot 5.7.1 -- so nothing needs installing in $HOME and the job
# does not depend on the Jupyter container's python. run_training.sh picks the
# CUDA view automatically when the slot has a GPU.
#
# The probe (condor/probe_env.sub) confirmed: $HOME and /data are both mounted on
# workers, and ~/venvs/vtx is NOT usable there (its python is a dangling symlink
# into the Jupyter container).
#
# Input ROOT files are read from an absolute /data path rather than transferred:
# they are GB-scale, and /data is already how the ntuples are read on workers.
# STAGE THEM FIRST:
#   mkdir -p /data/mcardiff/training
#   cp ~/project/vertex_timing/*/*_training.root /data/mcardiff/training/
#
#   cd condor && condor_submit train_transformer.sub && condor_q
#   # results land back in runs/<tag>/ next to this file
# ---------------------------------------------------------------------------
universe                = vanilla
executable              = run_training.sh

INPUT_DIR = /data/mcardiff/training
TAG       = $(selection)

# One row per configuration; add rows to the queue block to scan more.
# NOTE the lambda list is a LITERAL here, not a queue variable: condor splits
# `queue ... from (...)` rows on COMMAS, so a comma-containing value like
# "0,0.1,0.3,1.0" would be torn into separate columns and silently mis-bound.
arguments = train_transformer.py $(INPUT_DIR) runs/tf_$(TAG) --selection $(selection) --lambdas 0,0.1,0.3 --epochs 20

should_transfer_files   = YES
when_to_transfer_output = ON_EXIT
transfer_input_files    = ../python/train_transformer.py
transfer_output_files   = runs/tf_$(TAG)
# Condor flattens a nested transfer_output_files path to its basename on the way
# back, and the LHS of a remap must be a BARE NAME -- condor_submit(1): "You
# cannot specify directories to be remapped."
transfer_output_remaps  = "tf_$(TAG)=runs/tf_$(TAG)"

getenv                  = True
# Override the view (or bypass it) if ever needed:
# environment           = "LCG_VIEW=/cvmfs/sft.cern.ch/lcg/views/LCG_109/x86_64-el9-gcc15-opt"

+JobFlavour             = "tomorrow"

# ~340k parameters and attention over padded [events, <=101 tracks, features]
# tensors, so this is heavier than the Deep Sets job in both memory and compute.
# If it becomes the bottleneck, set request_gpus = 1 -- run_training.sh already
# switches to the CUDA LCG view automatically when a GPU is present. Note a GPU
# request that cannot match will sit idle forever, so check the probe first
# (condor/probe_env.sub queues a GPU row for exactly this).
request_cpus            = 4
request_memory          = 24GB
request_disk            = 8GB
request_gpus            = 0

output = logs/traintf_$(TAG).$(ClusterId).$(ProcId).out
error  = logs/traintf_$(TAG).$(ClusterId).$(ProcId).err
log    = logs/traintf_$(TAG).$(ClusterId).$(ProcId).log

# The lambda scan is done INSIDE one job (it shares the expensive data prep),
# so one row per selection is enough. Add (tight, ...) to compare selections.
# The lambda scan happens INSIDE one job (it shares the expensive data prep), so
# one row per selection is enough. Add `loose` once the novbs re-export exists --
# the current *_deta0p0_* file is the superseded attempt that only gained 4%.
queue selection in (tight)
