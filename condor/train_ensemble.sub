# ---------------------------------------------------------------------------
# train_ensemble.sub — N models on ONE event split, differing only in init.
#
# Motivated by a measurement, not a hunch. Four runs differing only in seed
# spread 2.4 points of Z+jets core fraction (65.1-67.5), while four runs at the
# SAME seed came out bit-identical -- infrastructure noise is exactly 0.000. So
# that spread is real variance between equally-valid models: each settles in a
# different minimum and misses a different set of events. Averaging their scores
# is the standard way to convert that variance into accuracy.
#
# This does not reopen the frozen architecture. Every member IS the frozen
# configuration; what changes is the selection PROCEDURE applied on top of them.
#
# THE SPLIT SEED IS FIXED AND THE INIT SEED VARIES. That is the entire point:
#   --seed       fixes the event split -> identical test fold for every member
#   --init-seed  fixes weights and batch order -> the diversity being exploited
# Varying --seed instead would give each member a different test fold, so member
# B would have trained on events in member A's test fold and any combined number
# would be leaked. python/ensemble_eval.py refuses to combine members whose
# recorded --seed differs, so this cannot go wrong silently.
#
#   cd condor && condor_submit train_ensemble.sub && condor_q
#
# then, once they land:
#   python3 ../python/ensemble_eval.py --input-dir /data/mcardiff/training \
#       --models runs/ens_i0,runs/ens_i1,runs/ens_i2,runs/ens_i3 \
#       --selection canonical --out runs/ensemble.json
#
# Read the gain against the BEST single member. Four models cost four times the
# compute, so beating the mean member is not enough to justify shipping it.
# ---------------------------------------------------------------------------
universe                = vanilla
executable              = run_training.sh

INPUT_DIR = /data/mcardiff/training
SELECTION = canonical
SPLIT     = 0
TAG       = ens_i$(init)

# The frozen configuration. --seed is pinned to $(SPLIT) for every member;
# only --init-seed moves.
arguments = train_deepsets.py $(INPUT_DIR) runs/$(TAG) --selection $(SELECTION) --epochs 15 --seed $(SPLIT) --init-seed $(init) --torch-threads 4

should_transfer_files   = YES
when_to_transfer_output = ON_EXIT
transfer_input_files    = ../python/train_deepsets.py
transfer_output_files   = runs/$(TAG)
transfer_output_remaps  = "$(TAG)=runs/$(TAG)"

getenv                  = True
+JobFlavour             = "tomorrow"

request_cpus            = 4
request_memory          = 16GB
request_disk            = 8GB
# 0, matching train_noise.sub. These members are compared against the noise
# measurement's spread, and that was taken on CPU slots -- combining CPU and GPU
# members would fold a hardware difference into the ensemble's apparent gain.
request_gpus            = 0

output = logs/train_$(TAG).$(ClusterId).$(ProcId).out
error  = logs/train_$(TAG).$(ClusterId).$(ProcId).err
log    = logs/train_$(TAG).$(ClusterId).$(ProcId).log

# Four members: enough to see whether the gain is real and roughly where it
# saturates, since ensemble gain grows with sqrt(N) and the step from 2 to 4 is
# the informative one. ensemble_eval.py reports every member individually, so a
# 2- and 3-member ensemble can be read off the same four runs without resubmitting.
queue init from (
  0
  1
  2
  3
)
