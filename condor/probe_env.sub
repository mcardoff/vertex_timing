# ---------------------------------------------------------------------------
# probe_env.sub — preflight for the Deep Sets training jobs. Run this FIRST.
#
# Reports what an execute node can actually see: GPU, whether $HOME (and so
# ~/venvs/vtx) is mounted, whether /data is mounted, and which python/torch is
# reachable. The pool is known NOT to share the submit directory with workers
# (CLAUDE.md), yet /data IS read by the existing jobs via absolute path -- so
# $HOME's visibility is the open question, and it decides how train_deepsets.sub
# should get torch.
#
#   cd condor && condor_submit probe_env.sub && condor_q
#   cat logs/probe_env.*.out
#
# Two slots are queued: one plain, one requesting a GPU. If the GPU one stays
# idle, the pool has no GPU slots matching and training runs on CPU (which is
# fine -- the model is 24k parameters).
# ---------------------------------------------------------------------------
universe                = vanilla
executable              = probe_env.sh
should_transfer_files   = YES
when_to_transfer_output = ON_EXIT
getenv                  = True
+JobFlavour             = "espresso"

request_cpus            = 1
request_memory          = 2GB
request_disk            = 1GB
request_gpus            = $(want_gpu)

output = logs/probe_env_gpu$(want_gpu).$(ClusterId).$(ProcId).out
error  = logs/probe_env_gpu$(want_gpu).$(ClusterId).$(ProcId).err
log    = logs/probe_env_gpu$(want_gpu).$(ClusterId).$(ProcId).log

queue want_gpu in (0, 1)
