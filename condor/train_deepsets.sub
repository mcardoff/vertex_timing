# ---------------------------------------------------------------------------
# train_deepsets.sub — Deep Sets cluster-selection training as a condor job.
#
# Torch comes from an LCG view on cvmfs (see run_training.sh) -- python 3.13.11,
# torch 2.11.0, uproot 5.7.1 -- so nothing needs installing in $HOME and the job
# does not depend on the Jupyter container's python. run_training.sh picks the
# CUDA view automatically when the slot has a GPU.
#
# The probe (condor/probe_env.sub) confirmed: $HOME and /data are both mounted on
# workers, and ~/venvs/vtx is NOT usable there (its python is a dangling symlink
# into the Jupyter container).
#
# Input ROOT files are read from an absolute /data path rather than transferred:
# they are GB-scale, and /data is already how the ntuples are read on workers.
# STAGE THEM FIRST:
#   mkdir -p /data/mcardiff/training
#   cp ~/project/vertex_timing/*/*_training.root /data/mcardiff/training/
#
#   cd condor && condor_submit train_deepsets.sub && condor_q
#   # results land back in runs/<tag>/ next to this file
# ---------------------------------------------------------------------------
universe                = vanilla
executable              = run_training.sh

INPUT_DIR = /data/mcardiff/training
TAG       = $(selection)

# One row per configuration; add rows to the queue block to scan more.
# --lambdas is no longer passed at all: the auxiliary head is OFF in the frozen
# configuration (train_deepsets.py's parse_args carries the evidence), so the
# default of "0" is what we want and naming it here would only invite drift.
#
# Kept as a warning for anything that DOES need a list: condor splits
# `queue ... from (...)` rows on COMMAS, so a comma-containing value like
# "0,0.1,0.3,1.0" is torn into separate columns and silently mis-bound. Pass such
# a value as a literal in `arguments`, never as a queue variable.
arguments = train_deepsets.py $(INPUT_DIR) runs/$(TAG) --selection $(selection) --epochs 15

should_transfer_files   = YES
when_to_transfer_output = ON_EXIT
transfer_input_files    = ../python/train_deepsets.py
transfer_output_files   = runs/$(TAG)
# Condor flattens a nested transfer_output_files path to its basename on the way
# back, and the LHS of a remap must be a BARE NAME -- condor_submit(1): "You
# cannot specify directories to be remapped."
transfer_output_remaps  = "$(TAG)=runs/$(TAG)"

getenv                  = True
# Override the view (or bypass it) if ever needed:
# environment           = "LCG_VIEW=/cvmfs/sft.cern.ch/lcg/views/LCG_109/x86_64-el9-gcc15-opt"

+JobFlavour             = "tomorrow"

# The model is ~24k parameters; the cost is streaming ~23M track rows and holding
# the per-sample tensors, not the maths. request_gpus=0 by default -- set it to 1
# only if the probe found GPU slots, since a GPU request that cannot match will
# sit idle forever.
request_cpus            = 4
request_memory          = 16GB
request_disk            = 8GB
# A GPU cluster is available on this pool, so this is 1 rather than 0. Note the
# standing caveat: a GPU request that cannot match sits idle forever, so if these
# stop starting, drop it back to 0. run_training.sh already selects the CUDA LCG
# view automatically when the slot actually has a GPU, so nothing else changes.
#
# BE HONEST ABOUT WHAT THIS BUYS. The last 15-epoch run spent ~120 s in epochs
# (8 s each) inside a ~10 min job -- the other ~8 min was streaming GB-scale ROOT
# files, which a GPU does not touch. Expect a small win now, and a real one only
# if --train-events or --epochs go up substantially.
request_gpus            = 1

output = logs/train_$(TAG).$(ClusterId).$(ProcId).out
error  = logs/train_$(TAG).$(ClusterId).$(ProcId).err
log    = logs/train_$(TAG).$(ClusterId).$(ProcId).log

# One row per selection. Both exports now exist:
#   canonical  --vbs-mjj=500   the analysis definition the baseline is quoted at
#   loose      --vbs-deta=-1   VBS pair requirement dropped; the wider population
# Run canonical for any number that will be compared against
# results/baseline_deta0p0_mjj500p0.md, and loose for the data-limitation study.
queue selection in (canonical, loose)
